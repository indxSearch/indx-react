{
  "name": "@indxsearch/systm",
  "version": "2.4.0",
  "description": "Minimal design system and UI component library for React. Includes buttons, inputs, sliders, checkboxes, tables, and more. Built with CSS modules and customizable via CSS variables.",
  "keywords": [
    "indx",
    "react",
    "components",
    "ui",
    "design-system",
    "component-library",
    "css-modules",
    "forms",
    "buttons",
    "inputs",
    "typescript",
    "minimalist",
    "ui-kit",
    "react-components"
  ],
  "author": "Indx Search",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/indxSearch/indx-react.git",
    "directory": "packages/indx-systm"
  },
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.22",
    "esbuild-css-modules-plugin": "^3.1.4",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./styles.css": "./dist/systm.css",
    "./cursors.css": "./dist/cursors.css",
    "./patterns.css": "./dist/patterns.css"
  },
  "dependencies": {
    "@indxsearch/pixl": "^1.5.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "react-range": "^1.10.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
