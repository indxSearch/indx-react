{
  "name": "@indxsearch/systm",
  "version": "2.1.0",
  "description": "Minimal design system and UI component library for React. Includes buttons, inputs, sliders, checkboxes, tables, and more. Built with CSS modules and customizable via CSS variables.",
  "keywords": [
    "indx",
    "react",
    "components",
    "ui",
    "design-system",
    "component-library",
    "css-modules",
    "forms",
    "buttons",
    "inputs",
    "typescript",
    "minimalist",
    "ui-kit",
    "react-components"
  ],
  "author": "Indx Search",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/indxSearch/indx-react.git",
    "directory": "packages/indx-systm"
  },
  "type": "module",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.22",
    "esbuild-css-modules-plugin": "^3.1.4",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./styles.css": "./dist/systm.css",
    "./cursors.css": "./dist/cursors.css",
    "./patterns.css": "./dist/patterns.css"
  },
  "dependencies": {
    "@indxsearch/pixl": "^1.4.0",
    "@radix-ui/react-select": "^2.2.6",
    "react-range": "^1.10.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
